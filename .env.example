# Backend runtime (pydantic-settings). Docker overrides API_HOST to 0.0.0.0.
API_HOST=127.0.0.1
API_PORT=18081
API_LOG_LEVEL=info
# Safe only while the backend is private, behind the trusted frontend proxy.
API_FORWARDED_ALLOW_IPS=*

# Authentication. Production requires HTTPS origins and Secure cookies.
AUTH_ALLOWED_ORIGINS=["http://127.0.0.1:18080","http://localhost:18080"]
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_DAYS=90
PASSWORD_MIN_LENGTH=12
LOGIN_USERNAME_LIMIT=5
LOGIN_IP_LIMIT=30
LOGIN_WINDOW_SECONDS=900
LOGIN_NGINX_RATE_PER_SECOND=5
LOGIN_NGINX_BURST=10
DEFAULT_LANGUAGE=en
# Set both credentials to activate recovery; leave both empty to deactivate it.
EMERGENCY_MANAGER_USERNAME=
EMERGENCY_MANAGER_PASSWORD=
EMERGENCY_MANAGER_FIRST_NAME=Emergency
EMERGENCY_MANAGER_LAST_NAME=Manager

# PostgreSQL. Generate a private password before starting the backend or Compose.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=15432
DATABASE_NAME=solfeo
DATABASE_USER=solfeo
DATABASE_PASSWORD=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_CONNECT_TIMEOUT_SECONDS=5
ALEMBIC_VERSION_SCHEMA=public

# Loopback host ports for the persistent development and disposable test databases.
POSTGRES_HOST_PORT=15432
TEST_POSTGRES_HOST_PORT=15433

# Vite development server. Never expose this server on the public Internet.
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=18080
API_PROXY_TARGET=http://127.0.0.1:18081

# Public build-time values. Never put secrets in VITE_* variables.
VITE_DEFAULT_LANGUAGE=en
VITE_HEALTH_TIMEOUT_MS=5000

# Local Docker stand.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=18080

# Production-only settings. Use an independent, ignored .env.production file.
# Image references must identify immutable releases; registry digests are preferred.
BACKEND_IMAGE=
FRONTEND_IMAGE=
PRODUCTION_WEB_PORT=18090
PRODUCTION_PROXY_NETWORK=solfeo-proxy
POSTGRES_ADMIN_PASSWORD=
MIGRATION_DATABASE_USER=solfeo_migrator
MIGRATION_DATABASE_PASSWORD=
PRODUCTION_MIGRATION_SCHEMA=migrations
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=3
