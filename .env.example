# Backend runtime (pydantic-settings). Docker overrides API_HOST to 0.0.0.0.
API_HOST=127.0.0.1
API_PORT=18081
API_LOG_LEVEL=info
# Safe only while the backend is private, behind the trusted frontend proxy.
API_FORWARDED_ALLOW_IPS=*

# Authentication. Production requires HTTPS origins and Secure cookies.
AUTH_ALLOWED_ORIGINS=["http://127.0.0.1:18080","http://localhost:18080"]
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_DAYS=90
PASSWORD_MIN_LENGTH=12
LOGIN_USERNAME_LIMIT=5
LOGIN_IP_LIMIT=30
LOGIN_WINDOW_SECONDS=900
LOGIN_NGINX_RATE_PER_SECOND=5
LOGIN_NGINX_BURST=10
DEFAULT_LANGUAGE=en
# Set both credentials to activate recovery; leave both empty to deactivate it.
EMERGENCY_MANAGER_USERNAME=
EMERGENCY_MANAGER_PASSWORD=
EMERGENCY_MANAGER_FIRST_NAME=Emergency
EMERGENCY_MANAGER_LAST_NAME=Manager

# Protected media. Compose fixes MEDIA_ROOT to the shared private volume mount.
MEDIA_ROOT=/app/media
IMAGE_MAX_BYTES=20971520
AUDIO_MAX_BYTES=52428800
UPLOAD_MAX_BYTES=74448896
IMAGE_MAX_PIXELS=40000000
AUDIO_MAX_SECONDS=1800
MEDIA_TIMEOUT_SECONDS=120
AUDIO_BITRATE_KBPS=128
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
FILE_BINARY=file

# OMR. Reserve at least the container limit plus host headroom before enabling.
OMR_ENABLED=true
# One exercise may continue on indented systems without starting a new movement.
OMR_DETECT_MOVEMENTS=false
# Retry missing staff detection once with a higher adaptive mean coefficient.
OMR_FAINT_MEAN_COEFF=0.9
OMR_BINARY=/opt/audiveris/bin/Audiveris
OMR_JAVA_HOME=/opt/java/openjdk
OMR_TESSDATA=/usr/share/tesseract-ocr/5/tessdata
OMR_JAVA_HEAP_MB=512
OMR_MEMORY_MB=1024
OMR_HOST_RESERVE_MB=512
OMR_CPUS=1
OMR_TMP_MB=256
OMR_TIMEOUT_SECONDS=300
OMR_LEASE_SECONDS=600
OMR_POLL_SECONDS=2
OMR_RETRY_SECONDS=30
OMR_MAX_ATTEMPTS=3
OMR_MAX_XML_BYTES=5242880
OMR_HEALTH_FILE=/tmp/omr-ready
OMR_HEALTH_SECONDS=600

# Offline speech generation only. Never expose this key to Vite or production containers.
OPENAI_API_KEY=
SPOKEN_MODEL=gpt-4o-mini-tts
SPOKEN_VOICE=coral
SPOKEN_TIMEOUT_SECONDS=60
SPOKEN_MAX_CLIP_BYTES=2097152
SPOKEN_MAX_CLIP_SECONDS=5
SPOKEN_OUTPUT=frontend/public/solfege

# Product Telegram worker. An empty token disables polling; never run two pollers.
TELEGRAM_TOKEN=
TELEGRAM_BOT_USERNAME=solfeo_exercises_bot
TELEGRAM_LINK_SECONDS=600
TELEGRAM_MAX_FILE_BYTES=20000000
TELEGRAM_POLL_SECONDS=25
TELEGRAM_HTTP_SECONDS=15
TELEGRAM_DOWNLOAD_SECONDS=90
TELEGRAM_RETRY_SECONDS=5
TELEGRAM_MAX_ATTEMPTS=3
TELEGRAM_HEALTH_SECONDS=600
TELEGRAM_HEALTH_FILE=/tmp/telegram-ready

# PostgreSQL. Generate a private password before starting the backend or Compose.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=15432
DATABASE_NAME=solfeo
DATABASE_USER=solfeo
DATABASE_PASSWORD=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_CONNECT_TIMEOUT_SECONDS=5
ALEMBIC_VERSION_SCHEMA=public

# Loopback host ports for the persistent development and disposable test databases.
POSTGRES_HOST_PORT=15432
TEST_POSTGRES_HOST_PORT=15433

# Vite development server. Never expose this server on the public Internet.
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=18080
API_PROXY_TARGET=http://127.0.0.1:18081

# Public build-time values. Never put secrets in VITE_* variables.
VITE_DEFAULT_LANGUAGE=en
VITE_HEALTH_TIMEOUT_MS=5000
VITE_UPLOAD_TIMEOUT_MS=600000
VITE_LISTENING_HEARTBEAT_MS=5000
VITE_SPOKEN_CONFIG={"defaultBpm":72,"minBpm":40,"maxBpm":160,"minRate":0.75,"maxRate":1.5,"maxSeconds":1800,"maxClipBytes":2097152,"maxClipSeconds":5}

# Local Docker stand.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=18080

# Production-only settings. Use an independent, ignored .env.production file.
# Image references must identify immutable releases; registry digests are preferred.
BACKEND_IMAGE=
FRONTEND_IMAGE=
PRODUCTION_WEB_PORT=18090
PRODUCTION_PROXY_NETWORK=solfeo-proxy
POSTGRES_ADMIN_PASSWORD=
MIGRATION_DATABASE_USER=solfeo_migrator
MIGRATION_DATABASE_PASSWORD=
PRODUCTION_MIGRATION_SCHEMA=migrations
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=3
