    {
      "id": "concept_solfeo_trainer",
      "label": "Solfège Trainer Application",
      "file_type": "concept",
      "source_file": "docs/PRODUCT_BRIEF.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Web app for solfège homework: sheet-music image and/or audio + text description; two roles (manager, student); target browsers Chrome 117+ and Safari 17+ only"
    },
    {
      "id": "concept_manager_role",
      "label": "Manager Role",
      "file_type": "concept",
      "source_file": "docs/PRODUCT_BRIEF.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Manager manages exercises (add/edit/delete/reorder), manages users (create, reset password, deactivate), reads listening journal; product-facing term is 'manager', not 'admin' or 'teacher'"
    },
    {
      "id": "concept_student_role",
      "label": "Student Role",
      "file_type": "concept",
      "source_file": "docs/PRODUCT_BRIEF.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Student can only listen to exercises (sequential or random) and change own settings; cannot access manager pages; product-facing term is 'student', not 'pupil' or 'child'"
    },
    {
      "id": "concept_exercise_model",
      "label": "Exercise Model",
      "file_type": "concept",
      "source_file": "docs/PRODUCT_BRIEF.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Exercise = id, title, description, category (optional), position, image (optional), audio (optional), score (optional from OMR), deleted_at (soft delete); at least one of image or audio required; soft delete only so journal survives deletion"
    },
    {
      "id": "concept_listening_journal",
      "label": "Listening Journal",
      "file_type": "concept",
      "source_file": "docs/PRODUCT_BRIEF.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "One row per listening session: start, heartbeat every 5s, end via sendBeacon on pagehide; completed = max_position >= 90% duration OR ended event; closed tab must still leave valid row; product-facing term is 'journal', not 'log' or 'history'"
    },
    {
      "id": "concept_omr_pipeline",
      "label": "OMR Pipeline (Audiveris)",
      "file_type": "concept",
      "source_file": "docs/PRODUCT_BRIEF.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Audiveris selected after evaluating 10 real exercise images; 8/10 meet threshold; async job queue (Postgres SKIP LOCKED); OmrEngine interface allows engine replacement; manager must approve before students see score; original image always kept as fallback"
    },
    {
      "id": "concept_spoken_notes",
      "label": "Spoken Notes Feature",
      "file_type": "concept",
      "source_file": "docs/PRODUCT_BRIEF.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Notes are spoken (not sung); pre-generated syllable clips via OpenAI TTS committed to frontend/public/solfege/<lang>/<naming>/; Web Audio API playback; preferred tempo 72 BPM; auto-reduce tempo when short notes require more speech time; available only when score approved"
    },
    {
      "id": "concept_telegram_import",
      "label": "Telegram Audio Import",
      "file_type": "concept",
      "source_file": "docs/PRODUCT_BRIEF.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Owner replaced PWA audio sharing with Telegram bot on 2026-09-29 after Android PWA share delivered empty form; real Telegram receipt and playback of 199163078.m4a confirmed; manager-only import; reuses PHASE 2 file pipeline"
    },
    {
      "id": "concept_emergency_manager",
      "label": "Emergency Manager",
      "file_type": "concept",
      "source_file": "docs/PRODUCT_BRIEF.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "On every backend start: if EMERGENCY_MANAGER_* env vars set, create/update user (role=manager, active, password reset); if not set, deactivate user with is_emergency=true; first-user mechanism AND disaster-recovery mechanism; emergency sync completes before backend startup succeeds"
    },
    {
      "id": "concept_material_design",
      "label": "Material Design Migration (MUI v9)",
      "file_type": "concept",
      "source_file": "docs/PHASES.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Separate feature after PHASE 7 acceptance; Material UI v9, Emotion, self-hosted Roboto, Community DataGrid v9; no Date Pickers (requires unapproved dependency); native dates, audio, tempo, score rendering unchanged; owner authorizes all remaining steps together on 2026-10-01"
    },
    {
      "id": "concept_auth_session",
      "label": "Authentication and Session Management",
      "file_type": "concept",
      "source_file": "docs/PRODUCT_BRIEF.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "scrypt with N=32768, r=8, p=3; 256-bit random session tokens; PostgreSQL stores only SHA-256 hashes; httpOnly, Secure, SameSite=Lax cookies; 90-day sliding lifetime; login rate limit per username+IP; CSRF via session-bound tokens in X-CSRF-Token header (except sendBeacon which uses JSON body)"
    },
    {
      "id": "concept_job_queue",
      "label": "Postgres Job Queue (SKIP LOCKED)",
      "file_type": "concept",
      "source_file": "docs/PRODUCT_BRIEF.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Postgres-based job queue using SELECT ... FOR UPDATE SKIP LOCKED; no Redis to reduce service count; job has status, attempts, last_error, locked_at; used by OMR worker; workers own separate engines and sessions"
    },
    {
      "id": "concept_protected_files",
      "label": "Protected File Serving (X-Accel-Redirect)",
      "file_type": "concept",
      "source_file": "docs/PRODUCT_BRIEF.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Files never served directly; nginx internal location + X-Accel-Redirect after backend auth check; Range requests required for Safari audio seeking; backend never reads file into memory; X-Accel-Redirect and nginx byte-range delivery confirmed in PHASE 0.5"
    },
    {
      "id": "concept_pre_commit_hooks",
      "label": "Pre-commit Hooks",
      "file_type": "concept",
      "source_file": ".pre-commit-config.yaml",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Backend: ruff check, ruff format, mypy strict; Frontend: eslint, prettier, tsc; same hooks run in CI; minimum pre-commit version 4.3.0; Node 22.23.3 with npm 12.1.0"
    },
    {
      "id": "concept_appearance_settings",
      "label": "Appearance Settings Feature",
      "file_type": "concept",
      "source_file": "docs/PHASES.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Separate branch feat/appearance-settings from c4ee4f1; independent light/dark schemes per account (classic, forest, warm, plum); fonts (Roboto, system, serif); base sizes (16, 18, 20px); live example panel before save; browser-local light/dark mode; migration 0007_appearance preserves existing accounts"
    }
