# Create a dedicated bot with @BotFather. Never put the token in Git or chat.
SOLFEO_TELEGRAM_PROTOTYPE_TOKEN=
# JSON array of authorized numeric Telegram user IDs. Empty means invalid configuration.
SOLFEO_TELEGRAM_PROTOTYPE_ALLOWED_USER_IDS=[]
SOLFEO_TELEGRAM_PROTOTYPE_LANGUAGE=ru
SOLFEO_TELEGRAM_PROTOTYPE_DATA_DIR=data
SOLFEO_TELEGRAM_PROTOTYPE_MAX_FILE_BYTES=20000000
SOLFEO_TELEGRAM_PROTOTYPE_STORAGE_LIMIT_BYTES=200000000
SOLFEO_TELEGRAM_PROTOTYPE_MIN_FREE_BYTES=100000000
SOLFEO_TELEGRAM_PROTOTYPE_MAX_AUDIO_SECONDS=900
SOLFEO_TELEGRAM_PROTOTYPE_POLL_SECONDS=25
SOLFEO_TELEGRAM_PROTOTYPE_HTTP_TIMEOUT_SECONDS=15
SOLFEO_TELEGRAM_PROTOTYPE_DOWNLOAD_TIMEOUT_SECONDS=90
SOLFEO_TELEGRAM_PROTOTYPE_MEDIA_TIMEOUT_SECONDS=120
SOLFEO_TELEGRAM_PROTOTYPE_RETRY_SECONDS=5
SOLFEO_TELEGRAM_PROTOTYPE_HEALTH_MAX_AGE_SECONDS=600
SOLFEO_TELEGRAM_PROTOTYPE_FILE_BINARY=/usr/bin/file
SOLFEO_TELEGRAM_PROTOTYPE_FFPROBE_BINARY=/usr/bin/ffprobe
SOLFEO_TELEGRAM_PROTOTYPE_FFMPEG_BINARY=/usr/bin/ffmpeg
SOLFEO_TELEGRAM_PROTOTYPE_AUDIO_BITRATE=128k
